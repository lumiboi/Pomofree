rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validProfilePhoto(value) {
      return value is string
        && value.size() <= 100000
        && (
          value == ''
          || value.matches('https://.*')
          || value.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]*')
        );
    }

    function validSocialProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'displayName',
          'totalMinutes',
          'completedSessions',
          'activeDays',
          'projectCount',
          'profilePhoto',
          'publicProfile',
          'updatedAt'
        ])
        && request.resource.data.userId == userId
        && validText(request.resource.data.displayName, 50)
        && request.resource.data.totalMinutes is int
        && request.resource.data.totalMinutes >= 0
        && request.resource.data.totalMinutes <= 5256000
        && request.resource.data.completedSessions is int
        && request.resource.data.completedSessions >= 0
        && request.resource.data.completedSessions <= 100000
        && request.resource.data.activeDays is int
        && request.resource.data.activeDays >= 0
        && request.resource.data.activeDays <= 36500
        && request.resource.data.projectCount is int
        && request.resource.data.projectCount >= 0
        && request.resource.data.projectCount <= 10000
        && request.resource.data.publicProfile is bool
        && validProfilePhoto(request.resource.data.profilePhoto)
        && (
          request.resource.data.publicProfile
          || request.resource.data.profilePhoto == ''
        )
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserData(userId);

      match /{document=**} {
        allow read, write: if ownsUserData(userId);
      }
    }

    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    // Kolektif kedi: herkes görebilir, yalnızca ileri gider ve tek seferde
    // günlük katkı tavanından fazlası eklenemez (plan §4.1, §14).
    match /collectiveCat/current {
      function validCatFields() {
        return request.resource.data.keys().hasOnly([
            'totalContribution', 'dailyContribution', 'dayKey', 'seasonId', 'updatedAt'
          ])
          && request.resource.data.totalContribution is int
          && request.resource.data.dailyContribution is int
          && request.resource.data.dailyContribution >= 0
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.size() <= 10
          && request.resource.data.seasonId is string
          && request.resource.data.seasonId.size() <= 7;
      }

      allow read: if true;
      allow create: if signedIn() && validCatFields()
        && request.resource.data.totalContribution > 0
        && request.resource.data.totalContribution <= 12;
      allow update: if signedIn() && validCatFields()
        && request.resource.data.totalContribution > resource.data.totalContribution
        && request.resource.data.totalContribution <= resource.data.totalContribution + 12;
    }

    match /moderators/{userId} {
      // Moderatör listesi konsoldan yönetilir; istemci yalnızca okuyabilir.
      allow read: if signedIn();
      allow write: if false;
    }

    match /reflections/{reflectionId} {
      function ownsReflection() {
        return signedIn() && (
          resource.data.authorId == request.auth.uid
          || exists(/databases/$(database)/documents/users/$(request.auth.uid)/myReflections/$(reflectionId))
        );
      }

      function validReflection() {
        return request.resource.data.keys().hasOnly([
            'authorId', 'displayName', 'body', 'kind', 'visibility',
            'isSensitive', 'moderationStatus', 'supportCount', 'createdAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 50
          && validText(request.resource.data.body, 1000)
          && request.resource.data.kind in ['reflection', 'progress', 'rest']
          && request.resource.data.visibility in ['anonymous', 'public']
          // Anonim paylaşımda ne ad ne de yazar kimliği yazılabilir (plan §7.2, §19).
          && (
            (request.resource.data.visibility == 'public'
              && request.resource.data.authorId == request.auth.uid)
            || (request.resource.data.visibility == 'anonymous'
              && request.resource.data.authorId == ''
              && request.resource.data.displayName == '')
          )
          && request.resource.data.isSensitive is bool
          && request.resource.data.moderationStatus == 'published'
          && request.resource.data.supportCount == 0
          && request.resource.data.createdAt is timestamp;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validReflection();
      // Yazar dışındakiler yalnızca destek sayacını bir artırabilir.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supportCount'])
        && request.resource.data.supportCount == resource.data.supportCount + 1;
      // Moderatör yalnızca görünürlük durumunu değiştirebilir; metne dokunamaz.
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationStatus'])
        && request.resource.data.moderationStatus in ['published', 'limited', 'removed'];
      allow delete: if ownsReflection() || isModerator();

      match /support/{userId} {
        allow read: if signedIn();
        allow create, update: if ownsUserData(userId)
          && request.resource.data.keys().hasOnly(['userId', 'type', 'createdAt'])
          && request.resource.data.userId == userId
          && request.resource.data.type in [
            'with_you', 'read', 'not_alone', 'hug', 'rest_is_okay', 'try_again'
          ]
          && request.resource.data.createdAt is timestamp;
        allow delete: if ownsUserData(userId);
      }
    }

    // Raporları yalnızca moderatörler okuyup kapatabilir (plan §8.4).
    match /reports/{reportId} {
      allow read: if isModerator();
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reflectionId', 'reporterId', 'reason', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && validText(request.resource.data.reflectionId, 128)
        && request.resource.data.reason in [
          'harassment', 'hate', 'personal_info', 'harmful_advice',
          'spam', 'sensitive', 'other'
        ]
        && request.resource.data.createdAt is timestamp;
    }

    match /socialProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsUserData(userId) && validSocialProfile(userId);
      allow delete: if ownsUserData(userId);
    }

    match /socialPosts/{postId} {
      function validPost() {
        return request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'body', 'mood', 'createdAt', 'reactions'
          ])
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.authorName, 50)
          && validText(request.resource.data.body, 400)
          && request.resource.data.mood in ['progress', 'victory', 'question', 'break']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.reactions is map;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validPost()
        && request.resource.data.reactions.size() == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map
        && request.resource.data.reactions.size() <= 200
        && request.resource.data.reactions.diff(resource.data.reactions)
          .affectedKeys().hasOnly([request.auth.uid])
        && (
          !request.resource.data.reactions.keys().hasAny([request.auth.uid])
          || request.resource.data.reactions[request.auth.uid]
            in ['support', 'spark', 'focus']
        );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        function validComment() {
          return request.resource.data.keys().hasOnly([
              'authorId', 'authorName', 'body', 'createdAt'
            ])
            && commentId == request.auth.uid
            && request.resource.data.authorId == request.auth.uid
            && validText(request.resource.data.authorName, 50)
            && validText(request.resource.data.body, 240)
            && request.resource.data.createdAt is timestamp;
        }

        allow read: if signedIn()
          && exists(/databases/$(database)/documents/socialPosts/$(postId));
        allow create, update: if signedIn()
          && exists(/databases/$(database)/documents/socialPosts/$(postId))
          && validComment();
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/socialPosts/$(postId))
            .data.authorId == request.auth.uid
        );
      }
    }

    match /studyRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participantIds == [request.auth.uid]
        && request.resource.data.roomType in ['private', 'anonymous']
        && (
          request.resource.data.roomType == 'private'
          || request.resource.data.hasPassword == false
        )
        && request.resource.data.capacity >= 2
        && request.resource.data.capacity <= 10;
      allow update: if signedIn()
        && request.resource.data.participantIds.size() <= request.resource.data.capacity
        && (
          (
            'participantIds' in resource.data
            && resource.data.participantIds.hasAny([request.auth.uid])
          )
          || (
            request.resource.data.participantIds.hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'participants',
                'participantIds',
                'password',
                'passwordHash',
                'passwordSalt'
              ])
          )
        );
      allow delete: if signedIn()
        && resource.data.participantIds.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        function isParticipant() {
          return signedIn()
            && get(/databases/$(database)/documents/studyRooms/$(roomId))
              .data.participantIds.hasAny([request.auth.uid]);
        }

        allow read: if isParticipant();
        allow create: if isParticipant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200;
        allow delete: if isParticipant()
          && (
            resource.data.senderUid == request.auth.uid
            || get(/databases/$(database)/documents/studyRooms/$(roomId))
              .data.participantIds.size() == 1
          );
      }
    }
  }
}
